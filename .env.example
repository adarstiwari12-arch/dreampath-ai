# Copy this file to ".env" and fill in the values. Never commit ".env".

# "development" enables debug mode. Use "production" when deploying.
FLASK_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development a key is generated automatically and stored in instance/.
SECRET_KEY=

# SQLite file location (relative paths are resolved from the project root).
DATABASE_PATH=instance/dreampath.db

# Set to true when the site is served over HTTPS (always in production).
SESSION_COOKIE_SECURE=false

# Minutes ahead of UTC for streaks and finish dates. 330 = India (IST).
UTC_OFFSET_MINUTES=330

# Optional: enables the LLM-powered answers. Without it, the app falls back
# to built-in rule-based recommendations, so everything still works.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
