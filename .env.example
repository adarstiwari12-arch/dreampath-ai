# Copy this file to ".env" and fill in the values. Never commit ".env".

# "development" enables debug mode. Use "production" when deploying.
FLASK_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# In development a key is generated automatically and stored in instance/.
SECRET_KEY=

# SQLite file location (relative paths are resolved from the project root).
DATABASE_PATH=instance/dreampath.db

# Set to true when the site is served over HTTPS (always in production).
SESSION_COOKIE_SECURE=false

# Minutes ahead of UTC for streaks and finish dates. 330 = India (IST).
UTC_OFFSET_MINUTES=330

# Optional: enables the LLM-powered answers. Works with any OpenAI-compatible
# provider (OpenRouter, Open Code, Together, Groq, …). Without a key, the app
# falls back to built-in rule-based recommendations, so everything still works.
# Get a free key from your provider, then set:
#   LLM_API_KEY=your-key-here
#   LLM_BASE_URL=https://openrouter.ai/api/v1   (or your provider's base URL)
#   LLM_API_PATH=/chat/completions               (default, usually fine)
#   LLM_MODEL=openrouter/auto                    (or a specific model id)
LLM_API_KEY=
LLM_BASE_URL=
LLM_API_PATH=/chat/completions
LLM_MODEL=openrouter/auto
